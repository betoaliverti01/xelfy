{
  "name": "Client",
  "type": "object",
  "properties": {
    "company": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "photo": {
      "type": "string",
      "description": "URL da foto/avatar do cliente"
    },
    "whatsapp": {
      "type": "string",
      "description": "Número do WhatsApp"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Email do cliente"
    },
    "document": {
      "type": "string",
      "description": "CPF ou CNPJ"
    },
    "address": {
      "type": "string",
      "description": "Endereço completo"
    }
  },
  "required": [
    "name"
  ]
}