{
  "name": "CatalogItem",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Código/SKU do item"
    },
    "name": {
      "type": "string",
      "description": "Nome do item"
    },
    "description": {
      "type": "string",
      "description": "Descrição detalhada do item"
    },
    "type": {
      "type": "string",
      "enum": [
        "Produto",
        "Serviço"
      ],
      "description": "Tipo do item"
    },
    "category": {
      "type": "string",
      "description": "Categoria do produto"
    },
    "sale_price": {
      "type": "number",
      "description": "Preço de venda"
    },
    "cost_price": {
      "type": "number",
      "description": "Preço de custo"
    },
    "stock": {
      "type": "number",
      "description": "Quantidade em estoque (apenas produtos)"
    },
    "control_stock": {
      "type": "boolean",
      "description": "Controlar estoque"
    },
    "photo": {
      "type": "string",
      "description": "URL da foto do item"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Produto em destaque na loja virtual"
    },
    "sales_count": {
      "type": "number",
      "default": 0,
      "description": "Contador de vendas"
    }
  },
  "required": [
    "name",
    "type",
    "sale_price"
  ]
}